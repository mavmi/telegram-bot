FROM bot_service_base_docker_image

ADD ./monitoring-telegram-bot-00.jar /monitoring-telegram-bot-00.jar

ENTRYPOINT java \
		-jar /monitoring-telegram-bot-00.jar \
		-XX:+UseContainerSupport \
		-XX:MaxRAMPercentage=70.0 \
		--spring.config.location=file:/volumes/monitoring-telegram-bot/spring/application-PROD.yaml \
		--spring.profiles.active=PROD