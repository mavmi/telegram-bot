FROM bot_service_base_docker_image

ADD ./shakal-telegram-bot-00.jar /shakal-telegram-bot-00.jar

ENTRYPOINT java \
		-jar /shakal-telegram-bot-00.jar \
		-XX:+UseContainerSupport \
		-XX:MaxRAMPercentage=70.0 \
		--spring.config.location=file:/volumes/shakal-telegram-bot/spring/application-PROD.yaml \
		--spring.profiles.active=PROD
