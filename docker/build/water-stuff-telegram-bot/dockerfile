FROM bot_service_base_docker_image

ADD ./water-stuff-telegram-bot-00.jar /water-stuff-telegram-bot-00.jar

ENTRYPOINT java \
		-jar /water-stuff-telegram-bot-00.jar \
		-XX:+UseContainerSupport \
		-XX:MaxRAMPercentage=70.0 \
		--spring.config.location=file:/volumes/water-stuff-telegram-bot/spring/application-PROD.yaml \
		--spring.profiles.active=PROD